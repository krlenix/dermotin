# Merge into hosting secrets; DO NOT replace existing legacy webhook variables.
# Key for the NEW Dermotin store only; never use NEXT_PUBLIC_ for secrets.
TOPOMS_ENABLED=true
TOPOMS_API_BASE_URL=https://app.topoms.com/custom-api/v1/01m1kz52cb4rgek92vzvvyxqv0
TOPOMS_API_KEY=SET_IN_HOSTING_SECRET_STORE
TOPOMS_LOCALE=rs
# Only include domains whose RSD orders belong to this TopOMS store.
TOPOMS_ALLOWED_DOMAINS=dermotin.shop,www.dermotin.shop

# Separate brand for dermotin.com and www.dermotin.com (server-only secret).
TOPOMS_COM_API_BASE_URL=https://app.topoms.com/custom-api/v1/01m1xjsdr45d1hefx9tg1zzep5
TOPOMS_COM_API_KEY=SET_IN_HOSTING_SECRET_STORE
NEXT_PUBLIC_APP_URL=https://dermotin.shop
NEXT_PUBLIC_DOMAIN=dermotin.shop
# Actual revision time of src/config/locales/rs/products.ts. Update when deploying catalog edits.
TOPOMS_CATALOG_UPDATED_AT=2026-07-30T14:34:56+02:00
SUPABASE_URL=KEEP_EXISTING_SUPABASE_URL
SUPABASE_ANON_KEY=SET_SERVER_SIDE_FOR_EXISTING_ORDER_STORAGE
SUPABASE_SERVICE_ROLE_KEY=SET_IN_HOSTING_SECRET_STORE
OMS_WORKER_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Existing setting MUST be false on production. It disables both destinations.
WEBHOOK_DRY_RUN=false
# Optional, for remote operational commands; default is NEXT_PUBLIC_APP_URL + this path.
# OMS_WORKER_URL=https://dermotin.shop/api/internal/oms
