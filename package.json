{
  "name": "dermotin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clear-build-cache.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:topoms && npm run test:orders",
    "build:prod": "NODE_ENV=production next build",
    "migration:map": "node scripts/generate-legacy-domain-map.mjs",
    "audit:migration": "node scripts/audit-local-migration.mjs",
    "test:topoms": "node -r ./scripts/register-ts.cjs --test tests/topoms.test.cjs tests/order-number.test.cjs",
    "topoms:check": "node scripts/topoms.cjs check",
    "topoms:connect": "node scripts/topoms.cjs connect",
    "topoms:rehearsal": "node scripts/topoms.cjs rehearsal",
    "topoms:sync": "node scripts/topoms.cjs sync-catalog",
    "topoms:drain": "node scripts/topoms.cjs drain",
    "topoms:status": "node scripts/topoms.cjs status",
    "topoms:replay": "node scripts/topoms.cjs replay-blocked",
    "test:orders": "node -r ./scripts/register-ts.cjs --test tests/order-guard.test.cjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/supabase-js": "^2.57.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@vercel/functions": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.18",
    "lucide-react": "^0.460.0",
    "next": "^15.5.15",
    "next-intl": "^3.25.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-phone-number-input": "^3.4.8",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
