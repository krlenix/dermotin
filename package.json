  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
