# Domain Configuration
NEXT_PUBLIC_DOMAIN=dermotin.shop
NEXT_PUBLIC_APP_URL=https://dermotin.shop
# ISO date/time kada je javni sadržaj poslednji put stvarno izmenjen (sitemap lastmod)
NEXT_PUBLIC_CONTENT_LAST_MODIFIED=2026-08-29

# Tracking Pixels - Serbia
NEXT_PUBLIC_GOOGLE_TAG=AW-16495784536
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-RZL04X9EGS
# Google Ads conversion label (deo iza "/" u send_to snippetu, Google Ads > Goals > Conversions)
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL=your_google_conversion_label
NEXT_PUBLIC_META_PIXEL_RS=your_actual_meta_pixel_id
NEXT_PUBLIC_TIKTOK_PIXEL_RS=your_actual_tiktok_pixel_id
NEXT_PUBLIC_GOOGLE_TAG_RS=AW-16495784536

# Per-site tracking (preferred for production). Recognized production domains
# are isolated: dermotin.co never falls back to dermotin.rs credentials.
# SITE_RS may temporarily fall back to the legacy RS variables above.
NEXT_PUBLIC_META_PIXEL_SITE_RS=your_dermotin_rs_meta_pixel_id
NEXT_PUBLIC_TIKTOK_PIXEL_SITE_RS=your_dermotin_rs_tiktok_pixel_id
NEXT_PUBLIC_GOOGLE_TAG_SITE_RS=AW-16495784536
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID_SITE_RS=G-RZL04X9EGS
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL_SITE_RS=your_dermotin_rs_conversion_label
META_CAPI_TOKEN_SITE_RS=your_dermotin_rs_meta_capi_token
META_CAPI_TEST_CODE_SITE_RS=

NEXT_PUBLIC_META_PIXEL_SITE_CO=your_dermotin_co_meta_pixel_id
NEXT_PUBLIC_TIKTOK_PIXEL_SITE_CO=your_dermotin_co_tiktok_pixel_id
NEXT_PUBLIC_GOOGLE_TAG_SITE_CO=AW-16495784536
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID_SITE_CO=G-RZL04X9EGS
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL_SITE_CO=your_dermotin_co_conversion_label
META_CAPI_TOKEN_SITE_CO=your_dermotin_co_meta_capi_token
META_CAPI_TEST_CODE_SITE_CO=

# Tracking Pixels - Bosnia
NEXT_PUBLIC_META_PIXEL_BA=your_actual_meta_pixel_id_ba
NEXT_PUBLIC_TIKTOK_PIXEL_BA=your_actual_tiktok_pixel_id_ba
NEXT_PUBLIC_GOOGLE_TAG_BA=your_actual_google_tag_id_ba

# Tracking Pixels - Bulgaria (example for future expansion)
NEXT_PUBLIC_META_PIXEL_BG=your_actual_meta_pixel_id_bg
NEXT_PUBLIC_TIKTOK_PIXEL_BG=your_actual_tiktok_pixel_id_bg
NEXT_PUBLIC_GOOGLE_TAG_BG=your_actual_google_tag_id_bg

# Tracking Pixels - Romania (example for future expansion)
NEXT_PUBLIC_META_PIXEL_RO=your_actual_meta_pixel_id_ro
NEXT_PUBLIC_TIKTOK_PIXEL_RO=your_actual_tiktok_pixel_id_ro
NEXT_PUBLIC_GOOGLE_TAG_RO=your_actual_google_tag_id_ro

# Add more countries as needed following the pattern:
# NEXT_PUBLIC_GOOGLE_TAG=AW-xxxxxxxxxx
# NEXT_PUBLIC_META_PIXEL_{COUNTRY_CODE}=pixel_id
# NEXT_PUBLIC_TIKTOK_PIXEL_{COUNTRY_CODE}=pixel_id
# NEXT_PUBLIC_GOOGLE_TAG_{COUNTRY_CODE}=AW-xxxxxxxxxx
# NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL_{COUNTRY_CODE}=conversion_label

# Social Media (Optional)
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/dermotin
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/dermotin
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@dermotin

# Admin panel (/admin) — content editing UI, single allowed account.
# ADMIN_PASSWORD_HASH format: "saltHex:hashHex" (scrypt). Generate via:
#   node -e "const{randomBytes,scryptSync}=require('crypto');const s=randomBytes(16);console.log(s.toString('hex')+':'+scryptSync(process.argv[1].normalize('NFKC'),s,64).toString('hex'))" "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=salt_hex:hash_hex
ADMIN_SESSION_SECRET=random_string_min_32_chars

# TopOMS order webhook authentication (server-only, isolated by production domain)
RS_ORDER_API_KEY_SITE_RS=
RS_ORDER_API_KEY_SITE_CO=

# Supabase — server koristi service-role ključ (porudžbine su lični podaci; anon ključ
# nema pristup tabeli orders posle migracije 20261028_orders_service_role_only.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OMS afilijacijski kodovi — SAMO serverski ključ (nikada NEXT_PUBLIC_*).
# Bez njega afilijacijski kuponi ne daju popust; statički kuponi iz admin panela rade.
AFFILIATE_API_KEY=
