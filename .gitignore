# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# admin panel backups of config files
/.admin-backups/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server log
.devserver.log

# browser test screenshots
/.playwright-mcp/

# impeccable: lokalni keš i live beleške (critique snimci ostaju u gitu)
/.impeccable/hook.cache.json
/.impeccable/live/
/.impeccable/config.local.json
